# photo_collector — QR card configuration
#
# Copy to .env and fill in real values:
#   cp .env.example .env
#
# .env is git-ignored. Never commit it. Never put real values in this file.
#
# WARNING: these credentials end up in the QR code and are visible to every
# guest who scans it. Use ONLY the per-event put-only IAM key — never an
# admin key.

# --- Event token fields (required) ---
# Per-event infrastructure: bucket name = event ID = hosting project name.
# The event name itself is not part of the token; the bucket carries it.
ACCESS_KEY_ID=AKIAIOSFODNN7EXAMPLE
SECRET_ACCESS_KEY=wJalrXUtnFEMI/K7MDENG/bPxRfiCYEXAMPLEKEY
BUCKET=wedding-2026-06
REGION=eu-central-1
# ENDPOINT=                  # optional — omit for AWS S3 default endpoints

# --- App base URL the QR code points to (required) ---
BASE_URL=https://photos.example.com

# --- Card output (optional) ---
OUTPUT=card.svg
# TITLE=                     # avoid spaces/quotes; pass via QR_ARGS if needed
# FOREGROUND=#000000
# BACKGROUND=#ffffff
